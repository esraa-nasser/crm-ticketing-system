@page "/signin"
@inject AuthApiClient AuthApi
@inject TokenStore Tokens
@inject NavigationManager Navigation

<PageTitle>Sign in</PageTitle>

<h1>Sign in</h1>

@if (Tokens.IsSignedIn)
{
    <div class="alert alert-success" role="alert">
        <p class="mb-1">Signed in as <strong>@Tokens.Email</strong>.</p>
        <p class="mb-2 small">Roles: @string.Join(", ", Tokens.Roles)</p>
        <a class="btn btn-sm btn-outline-secondary" href="tickets">Go to tickets</a>
        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="SignOut">Sign out</button>
    </div>
}
else
{
    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    <EditForm Model="_model" OnValidSubmit="Submit" FormName="signin">
        <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="_model.Email" autocomplete="username" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <InputText id="password" type="password" class="form-control"
                       @bind-Value="_model.Password" autocomplete="current-password" />
        </div>
        <button type="submit" class="btn btn-primary" disabled="@_busy">
            @(_busy ? "Signing in…" : "Sign in")
        </button>
    </EditForm>
}

@code {
    private sealed class SignInModel
    {
        public string Email { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;
    }

    private readonly SignInModel _model = new();
    private string? _error;
    private bool _busy;

    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private async Task Submit()
    {
        _busy = true;
        _error = null;

        try
        {
            var response = await AuthApi.SignInAsync(
                new SignInRequest(_model.Email, _model.Password),
                CancellationToken.None);

            Tokens.Set(response.AccessToken, response.Email, response.UserId, response.Roles);
            Navigation.NavigateTo(SafeReturnUrl());
        }
        catch (Exception ex) when (ex is ApiRequestException or HttpRequestException or TaskCanceledException)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Where to land after signing in: the requested <c>returnUrl</c> when it is a
    /// same-site path, the ticket list otherwise.
    /// </summary>
    /// <remarks>
    /// The check is a security control, not tidiness. Navigating to an unchecked
    /// <c>returnUrl</c> makes this page an open redirect: a link to
    /// <c>/signin?returnUrl=https://evil.example</c> would send a user who has just
    /// typed their password to another site, and it would look as though this
    /// application sent them. Only a path beginning with a single "/" is accepted —
    /// "//host" is protocol-relative and reaches another origin.
    /// </remarks>
    private string SafeReturnUrl()
    {
        const string Default = "tickets";

        if (string.IsNullOrWhiteSpace(ReturnUrl))
        {
            return Default;
        }

        var candidate = ReturnUrl.Trim();

        return candidate.StartsWith('/') && !candidate.StartsWith("//", StringComparison.Ordinal)
            ? candidate
            : Default;
    }

    private void SignOut()
    {
        Tokens.Clear();
        _model.Email = string.Empty;
        _model.Password = string.Empty;
    }
}
